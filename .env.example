# ---------------------------------------------------------------------------
# AudioSense AI — Environment Variable Template
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your IBM credentials.
# NEVER commit .env to version control.
#
# IBM watsonx.ai credentials (required for live IBM Granite responses)
# Without these, the app runs in clearly-labelled DEMO MODE.
# ---------------------------------------------------------------------------

IBM_API_KEY=your_ibm_cloud_api_key_here
IBM_PROJECT_ID=your_watsonx_project_id_here
IBM_GRANITE_MODEL=ibm/granite-13b-chat-v2
IBM_ENDPOINT=https://us-south.ml.cloud.ibm.com

# ---------------------------------------------------------------------------
# How to obtain credentials:
# 1. Create an IBM Cloud account at https://cloud.ibm.com
# 2. Provision a Watson Machine Learning service instance.
# 3. Create a project in IBM watsonx.ai (https://dataplatform.cloud.ibm.com).
# 4. Generate an IBM Cloud API key at:
#    IBM Cloud → Manage → Access (IAM) → API keys
# 5. Copy your Project ID from the watsonx.ai project settings.
# ---------------------------------------------------------------------------
